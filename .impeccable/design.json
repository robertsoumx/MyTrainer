      "css": ".ds-primary{font:550 13px/1.5 Inter,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:11px 19px;border-radius:6px;cursor:pointer;transition:background .15s,filter .15s;background:var(--accent,#f17a59);color:var(--accent-ink,#111315);border:0}.ds-primary:hover:not(:disabled){filter:brightness(1.08)}.ds-primary:focus-visible{outline:2px solid var(--accent-text,#ffab8b);outline-offset:4px;}.ds-primary:disabled{opacity:.45;cursor:default}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
