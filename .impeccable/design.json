      "css": ".ds-label{display:block;font:400 13px/1.5 Inter,Arial,sans-serif;color:var(--muted,#a4aab2);max-width:360px}.ds-field{box-sizing:border-box;display:block;width:100%;min-width:0;min-height:44px;margin-top:9px;padding:10px 12px;font:400 14px/1.5 Inter,Arial,sans-serif;background:var(--raised,#24282c);color:var(--text,#eeeef0);border:1px solid var(--line,#33383e);border-radius:6px;caret-color:var(--accent,#f17a59)}.ds-field:focus-visible{outline:2px solid var(--accent-text,#ffab8b);outline-offset:4px;}.ds-field:disabled{opacity:.45}"
