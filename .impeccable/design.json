    },
    {
      "name": "Drill Card",
      "kind": "card",
      "refersTo": "drill-card",
      "description": "Precision card using the exact code-native preview geometry and short instruction.",
      "html": "<article class=\"ds-card\"><svg class=\"ds-card-preview\" viewBox=\"0 0 320 160\" aria-hidden=\"true\"><path d=\"M28 25h264v118H28z\" stroke=\"currentColor\" stroke-width=\".6\" fill=\"none\" opacity=\".13\"/><g fill=\"currentColor\"><circle cx=\"86\" cy=\"55\" r=\"5\"/><circle cx=\"156\" cy=\"77\" r=\"5\"/><circle cx=\"210\" cy=\"44\" r=\"5\"/><circle cx=\"105\" cy=\"110\" r=\"5\"/><circle cx=\"235\" cy=\"105\" r=\"5\"/><circle cx=\"178\" cy=\"126\" r=\"5\"/></g></svg><div class=\"ds-card-copy\"><div class=\"ds-card-title\"><h2>Precision</h2><span>L3</span></div><p>Click the small orbs. Make every shot count.</p><div class=\"ds-card-foot\"><span>Not measured</span><button class=\"ds-card-start\">Start</button></div></div></article>",
      "css": ".ds-card{max-width:520px;border:1px solid var(--line,#33383e);border-radius:var(--radius,12px);overflow:hidden;background:var(--surface,#1c1f22);color:var(--text,#eeeef0);font:400 14px/1.5 Inter,Arial,sans-serif}.ds-card-preview{display:block;width:100%;height:180px;background:#142137;color:#48d9fa;transition:background .2s}.ds-card-copy{padding:24px}.ds-card-title{display:flex;justify-content:space-between;gap:14px;align-items:center}.ds-card-title h2{margin:0;font-size:19px;letter-spacing:-.02em;font-weight:550}.ds-card-title>span{font-size:12px;color:var(--muted,#a4aab2)}.ds-card-copy>p{margin:8px 0 0;font-size:13px;color:var(--muted,#a4aab2)}.ds-card-foot{display:flex;justify-content:space-between;align-items:center;margin-top:26px;gap:15px}.ds-card-foot>span{font-size:12px;color:var(--muted,#a4aab2)}.ds-card-start{font:550 13px/1.5 Inter,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:11px 19px;border-radius:6px;cursor:pointer;transition:background .15s,filter .15s;min-width:92px;background:var(--accent,#f17a59);color:var(--accent-ink,#111315);border:0}.ds-card-start:hover{filter:brightness(1.08)}.ds-card-start:focus-visible{outline:2px solid var(--accent-text,#ffab8b);outline-offset:4px;}.ds-card:has(button:hover) .ds-card-preview{background:#1b2c46}@media(prefers-reduced-motion:reduce){.ds-card-preview,.ds-card-start{transition:none}}"
    },
