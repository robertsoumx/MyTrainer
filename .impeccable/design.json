  "narrative": {
    "northStar": "Matte Aim Room",
    "overview": "The application uses a restrained graphite and coral shell around an abstract blue practice room. Controls are flat, compact and legible. The room carries the spatial character: matte architecture, smooth luminous spheres and thin cyan strips, with the interface receding around the target.\n\nLight mode changes the application shell to cool off-white surfaces. The range retains its blue environment in either theme. Existing Inter Variable provides all typography; illustrations are exact inline SVG geometry, and the room is Three.js geometry. This implementation introduces no shipping raster artwork or new typeface.\n\nThis document records the implementation in `dist/style.css`, `dist/app.js`, `dist/core.js` and `src/fps-engine.js`, with the current desktop and mobile shell/brief captures as supporting evidence. There is no approved image comp. The available browser reports disabled GPU rendering, so the 3D material and bloom descriptions are source-derived and do not certify their rendered GPU appearance.",
    "keyCharacteristics": [
      "Graphite or cool off-white surfaces with a configurable coral action accent.",
      "Matte blue room, thin cyan light strips and smooth colored target spheres.",
      "Flat bordered controls, modest corners and short functional copy.",
      "Code-native previews and immediate spatial hit feedback without camera kick."
    ],
    "rules": [
      {
        "name": "The Theme Boundary Rule",
        "body": "Theme and accent customization recolor the application controls; preserve the fixed blue range and the four drill identities.",
        "section": "colors"
      },
      {
        "name": "The Short Instruction Rule",
        "body": "Keep the prominent instruction to the physical action; place scoring explanations behind the existing disclosure.",
        "section": "typography"
      },
      {
        "name": "The Flat Shell Rule",
        "body": "Keep persistent cards and controls flat; reserve glow for targets and room light strips.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** retain the graphite/coral shell and its cool light-mode counterpart.",
      "**Do** preserve the four drill colors across previews, histories and 3D targets.",
      "**Do** keep the room matte blue, its light strips thin and target glow restrained.",
      "**Do** keep controls visibly focusable and honor the reduced motion and glow setting.",
      "**Do** keep previews code-native and use the existing Inter Variable font.",
      "**Do** distinguish source-derived 3D styling from verified GPU appearance."
    ],
    "donts": [
      "**Don't** add a weapon viewmodel, recoil camera kick, realistic materials or humanoid targets.",
      "**Don't** introduce more drill categories, decision quizzes or tactical content into the four-drill interface.",
      "**Don't** add marketing slogans, emojis or long explanations to primary flows.",
      "**Don't** replace flat shell surfaces with decorative glow or heavy shadows, or turn code-native previews into raster approximations.",
      "**Don't** let light mode erase the blue range or let shell accent changes recolor drill identities."
    ]
  }
}
